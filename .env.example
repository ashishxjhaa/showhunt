# PostgreSQL connection string (Neon recommended)
DATABASE_URL="postgresql://user:password@host:5432/backit?sslmode=require"

# Secret for signing JWT tokens (use a long random string)
JWT_SECRET="your-secret-key-here"

# Optional: credentials for README screenshot capture (bun run screenshots)
# SCREENSHOT_EMAIL="screenshot@backit.dev"
# SCREENSHOT_PASSWORD="your-screenshot-password"
# SCREENSHOT_BASE_URL="http://localhost:3000"
