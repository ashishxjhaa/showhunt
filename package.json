{
  "name": "showhunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "web:dev": "bun run --cwd apps/web dev",
    "server:dev": "bun run --cwd apps/server dev",
    "db:migrate": "bun run --cwd apps/server db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
